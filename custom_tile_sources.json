{
    "version": 1,
    "sources": [
        {
            "id": "custom_tencent_vector",
            "name": "腾讯地图",
            "urlTemplate": "http://rt{s}.map.gtimg.com/realtimerender?z={z}&x={x}&y={-y}&type=vector&style=0",
            "subdomains": ["0", "1", "2", "3"],
            "scheme": "XYZ",
            "minZoom": 3,
            "maxZoom": 18,
            "coordinateSystem": "Gcj02"
        },
        {
            "id": "google_satellite",
            "name": "Google 卫星",
            "urlTemplate": "https://mt{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
            "subdomains": ["0", "1", "2", "3"],
            "scheme": "XYZ",
            "minZoom": 1,
            "maxZoom": 20,
            "coordinateSystem": "Wgs84"
        },
        {
            "id": "google_map",
            "name": "Google 地图",
